<launch>
    <arg name="simulation" default="true"/>
    <arg name="network" default="lo"/>
    <arg name="pose_source_odom" default="/g1_controller/sport_mode/odom"/>

    <node pkg="g1_controller" type="g1_controller" name="g1_controller" output="screen">
        <param name="simulation" value="$(arg simulation)"/>
        <param name="network" value="$(arg network)"/>
        <remap from="/g1_controller/pose_source/odom" to="$(arg pose_source_odom)"/>
    </node>

    <include file="$(find g1_description)/launch/g1_description.launch"/>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find g1_controller)/config/rviz/config.rviz"/>
</launch>
