<launch>
    <arg name="network" default="lo"/>
    <arg name="lidar" default="false"/>
    <node pkg="g1_controller" type="g1_controller" name="g1_controller" output="screen">
        <param name="network" value="$(arg network)"/>
    </node>
    <include file="$(find g1_description)/launch/g1_description.launch"/>
    <include file="$(find livox_ros_driver2)/launch_ROS1/msg_MID360.launch" if="$(arg lidar)"/>
    <include file="$(find fast_lio)/launch/mapping_mid360_g1.launch">
        <arg name="rviz" value="true"/>
    </include>
</launch>
