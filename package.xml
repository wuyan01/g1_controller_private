<?xml version="1.0"?>
<package format="3">
  <name>g1_controller</name>
  <version>0.1.0</version>
  <description>
    G1 robot controller.
  </description>

  <!-- Your info -->
  <maintainer email="chenhli@leggedrobotics.com">Chenhao Li</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS dependencies -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>grid_map_core</depend>
  <depend>grid_map_ros</depend>
  <depend>grid_map_msgs</depend>
  <depend>ament_index_cpp</depend>
  <exec_depend>g1_description</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>

  <!-- System libraries your CMakeLists finds/resolves -->
  <depend>boost</depend>
  <depend>yaml-cpp</depend>
  <depend>eigen</depend>

  <!-- No third-party libs (ONNX, DDS, Iceoryx, Unitree SDK, OCS2) should be listed here -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
